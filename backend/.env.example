# ==============================================================================
# Environment Configuration for Kidney Disease Detection Backend
# ==============================================================================

# Database Connection URL:
# 1. Local Development (SQLite):
# DATABASE_URL=sqlite:///./kidney_ai.db

# 2. Production (Supabase PostgreSQL via Session/Transaction Pooler - IPv4 compatible):
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Frontend URL for CORS (e.g., your Vercel deployment URL or "*" during testing):
FRONTEND_URL=https://your-frontend.vercel.app

# Server Port (Render sets this dynamically via $PORT):
PORT=8000
