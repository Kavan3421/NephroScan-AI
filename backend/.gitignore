# ==============================================================================
# Backend .gitignore - Kidney Disease Detection API
# ==============================================================================

# Environment files & Secrets (NEVER COMMIT SENSITIVE CREDENTIALS)
.env
.env.*
!.env.example

# Local SQLite Database files
*.db
*.sqlite
*.sqlite3
kidney_ai.db

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs & Temporary Uploads
*.log
logs/
temp/
uploads/

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
